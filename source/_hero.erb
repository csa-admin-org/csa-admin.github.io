<section class="mt-16 md:mt-24 lg:mt-28 lg:grid lg:grid-cols-[2fr_2fr] lg:gap-10 xl:gap-12 lg:items-center">
  <div class="text-center lg:text-left">
    <h1 class="tracking-tight text-4xl md:text-5xl xl:text-6xl font-extrabold">
      <%= I18n.t 'title', org_name: content_tag(:span, t("org_name"), class: "text-logo-green drop-shadow-sm", title: t("org_name_definition")) %>
    </h1>

    <p class="mt-4 lg:mt-6 mx-auto lg:mx-0 lg:max-w-xl text-pretty md:leading-normal text-xl font-light">
      <%= I18n.t 'subtitle', orgs_link: link_to(t('subtitle_orgs_link'), '#organizations'), baskets_count: format_number(data.site.baskets_count) %>
    </p>

    <%= partial :ctas, locals: { align: :start } %>
  </div>

  <%= partial :screenshots %>
</section>
